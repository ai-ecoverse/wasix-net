  },
  "devDependencies": {
    "@ai-ecoverse/slicc-kernel": "1.143.2",
    "@ai-ecoverse/slicc-shared-web": "1.30.1",
    "@biomejs/biome": "2.5.15",
    "lefthook": "2.2.2",
    "semantic-release": "25.0.9"
  }
}
